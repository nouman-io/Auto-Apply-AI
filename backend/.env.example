# Environment settings template
PROJECT_NAME="Auto Apply AI"
API_V1_STR="/api/v1"

# Database Configurations
POSTGRES_SERVER="localhost"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_development_secure_pass"
POSTGRES_DB="auto_apply_db"
POSTGRES_PORT="5432"
DATABASE_URL="postgresql://postgres:password@localhost:5432/auto_apply_db"

# Redis Configurations
REDIS_HOST="localhost"
REDIS_PORT=6379

# Deployment & CORS Setup
CORS_ORIGINS="http://localhost:3000"
ALLOWED_HOSTS="*"
FRONTEND_BASE_URL="http://localhost:3000"
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/auth/gmail/callback"
NEXT_PUBLIC_API_BASE="http://localhost:8000"

# Uploads
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_MB=10

# Security Setup
SECRET_KEY="replace_this_with_a_properly_generated_secure_secret_key_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# OpenAI & Gemini API Keys
OPENAI_API_KEY=""
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Optional SerpAPI Key for Google Jobs
SERPAPI_API_KEY=""
